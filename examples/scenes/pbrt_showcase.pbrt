# A compact PBRT-v4-style Cornell scene used by the Bajo loader example.
LookAt 0 2.0 7.2   0 1.7 0   0 1 0
Camera "perspective" "float fov" [38]
Film "rgb" "integer xresolution" [640] "integer yresolution" [480]
Sampler "independent" "integer pixelsamples" [64]
Integrator "path" "integer maxdepth" [10]

WorldBegin
MakeNamedMaterial "white" "string type" ["diffuse"] "rgb reflectance" [0.72 0.72 0.72]
MakeNamedMaterial "red" "string type" ["diffuse"] "rgb reflectance" [0.68 0.08 0.06]
MakeNamedMaterial "green" "string type" ["diffuse"] "rgb reflectance" [0.08 0.55 0.12]
MakeNamedMaterial "metal" "string type" ["conductor"] "rgb reflectance" [0.9 0.7 0.35] "float roughness" [0.12]
MakeNamedMaterial "glass" "string type" ["dielectric"] "float eta" [1.5]

AttributeBegin
NamedMaterial "white"
Shape "trianglemesh"
    "point3 P" [-2 0 -2  -2 0 2  2 0 2  2 0 -2]
    "integer indices" [0 1 2  0 2 3]
Shape "trianglemesh"
    "point3 P" [-2 0 -2  2 0 -2  2 4 -2  -2 4 -2]
    "integer indices" [0 1 2  0 2 3]
AttributeEnd

AttributeBegin
NamedMaterial "red"
Shape "trianglemesh"
    "point3 P" [-2 0 2  -2 0 -2  -2 4 -2  -2 4 2]
    "integer indices" [0 1 2  0 2 3]
AttributeEnd

AttributeBegin
NamedMaterial "green"
Shape "trianglemesh"
    "point3 P" [2 0 -2  2 0 2  2 4 2  2 4 -2]
    "integer indices" [0 1 2  0 2 3]
AttributeEnd

AttributeBegin
AreaLightSource "diffuse" "rgb L" [15 13 10]
Shape "trianglemesh"
    "point3 P" [-0.7 3.8 -0.7  0.7 3.8 -0.7  0.7 3.8 0.7  -0.7 3.8 0.7]
    "integer indices" [0 1 2  0 2 3]
AttributeEnd

Include "pbrt_showcase_objects.pbrt"
WorldEnd
